---
import { type CollectionEntry, render } from "astro:content";
import BaseLayout from "./Base.astro";
import { getFormattedDate } from "@/utils/date";

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, tags, background } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();

// Estimate reading time
const { headings } = await render(post);
const bodyText = post.body || "";
const wordCount = bodyText.replace(/\s+/g, "").length;
const readingTime = Math.max(1, Math.round(wordCount / 400));

// Build TOC (strip inline HTML like star markers from heading text)
let tocHtml = '<p style="color: var(--wm-muted); font-style: italic; font-size: 0.75rem">No sections</p>';
if (headings.length > 0) {
  tocHtml = headings.map((h: any) =>
    `<a href="#${h.slug}" class="block py-0.5 transition-colors text-xs" style="padding-left:${(h.depth-1)*0.8}rem; color: var(--wm-ink-soft)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-ink-soft)'">${h.text.replace(/<[^>]+>/g, "")}</a>`
  ).join('');
}
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
  {
    background && (
      <>
        <style is:inline define:vars={{ background }}>
          html.has-post-bg #wm-particle { display: none; }
          html.has-post-bg body.wm-body::before {
            display: block;
            content: "";
            background-image: url(var(--background));
            background-size: cover;
            background-position: center;
          }
        </style>
        <script is:inline>
          document.documentElement.classList.add("has-post-bg");
        </script>
      </>
    )
  }
  <article class="glass-card !p-8 md:!p-12">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">{title}</h1>
      <!-- Post meta -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-mono text-xs" style="color: var(--wm-muted)">
        <time datetime={publishDate.toISOString()}>
          <svg class="inline-block w-3.5 h-3.5 mr-1 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {getFormattedDate(publishDate, { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <span>·</span>
        <span>
          <svg class="inline-block w-3.5 h-3.5 mr-1 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
          </svg>
          {readingTime} min read
        </span>
        {tags.length > 0 && (
          <>
            <span>·</span>
            <span class="flex flex-wrap items-center gap-1">
              <svg class="inline-block w-3.5 h-3.5 mr-0.5 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
              {tags.map((tag, i) => (
                <span>
                  <a href={`/tags/${tag}/`} class="transition-colors" style="color: var(--wm-primary)">{tag}</a>
                  {i < tags.length - 1 ? <span style="color: var(--wm-faint)">,</span> : ""}
                </span>
              ))}
            </span>
          </>
        )}
      </div>
      {updatedDate && updatedDate > publishDate && (
        <p class="text-xs mt-2 italic" style="color: var(--wm-muted)">
          Updated: {getFormattedDate(updatedDate, { year: "numeric", month: "long", day: "numeric" })}
        </p>
      )}
    </header>

    <div class="prose max-w-none">
      <slot />
    </div>
  </article>

  <!-- Giscus Comments -->
  <div class="glass-card !p-6 mt-8">
    <script src="https://giscus.app/client.js"
      data-repo="yahoofunny/blog"
      data-repo-id="R_kgDOS56yEA"
      data-category="General"
      data-category-id="DIC_kwDOS56yEM4DABSb"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="light"
      data-lang="zh-CN"
      crossorigin="anonymous"
      async>
    </script>
  </div>

  <div class="text-center mt-8">
    <a href="/" class="transition-colors text-sm font-mono" style="color: var(--wm-muted)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-muted)'">&larr; Back to Home</a>
  </div>
</BaseLayout>

<script define:vars={{ tocHtml }}>
  // Fill all TOC navs (desktop + mobile sidebar both render SidebarContent)
  document.querySelectorAll('#toc-nav').forEach(function(el) { el.innerHTML = tocHtml; });
</script>
