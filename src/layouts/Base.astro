---
import BaseHead from "@/components/BaseHead.astro";
import LangSwitch from "@/components/LangSwitch.astro";
import SidebarContent from "@/components/SidebarContent.astro";
import { htmlLang, useTranslations } from "@/i18n/ui";
import { getLocaleFromPath, localizePath } from "@/i18n/utils";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/** 聊天页自己就是聊天界面，右下角再飘一只会挡输入框 */
	hidePet?: boolean;
	/** 聊天页要整块地方给对话框，左边那条侧栏（文章数/标签）在那儿没意义 */
	hideSidebar?: boolean;
}

const { meta, hidePet = false, hideSidebar = false } = Astro.props;
const { articleDate, description = siteConfig.description, ogImage, title } = meta;

// 语言：/en/... 走英文站，其余是中文站
const pathname = Astro.url.pathname;
const lang = getLocaleFromPath(pathname);
const t = useTranslations(lang);
const L = (path: string) => localizePath(path, lang);
---

<html class="scroll-smooth" lang={htmlLang[lang]}>
  <head>
    <BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
    <script is:inline>
      // 默认暗色；只有明确选过亮色才打开亮色
      if (localStorage.getItem('theme') !== 'light') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="wm-body min-h-screen">
    <!-- Hidden checkbox for mobile menu hamburger animation -->
    <input type="checkbox" id="menu-toggle" class="hidden" onchange="document.getElementById('mobile-menu').style.display=this.checked?'flex':'none'" />
    <script is:inline>
      // 颜文字模式：在当前语言的页面上，给句末标点后面随机插一个颜文字
      // 纯客户端显示效果，不动路由、不请求接口
      var _kao=["(´・ω・`)","(◕‿◕)","(｡･ω･｡)","(≧∇≦)","(๑•̀ㅂ•́)و✧","(◍•ᴗ•◍)","(╯°□°）╯︵┻━┻","┐(´д`)┌","(￣▽￣)ノ","(✿◠‿◠)","(´▽`)ﾉ","(・∀・)","(◕ᴗ◕✿)","(｡•̀ᴗ-)✧","(◔‿◔)","(─‿‿─)","(人◕ω◕)","(づ｡◕‿‿◕｡)づ","(ﾉ◕ヮ◕)ﾉ*:･ﾟ✧"];
      var _kaoOn=false;
      function _walkNodes(){
        var w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT,null,false);
        var nodes=[],n;
        while(n=w.nextNode()){
          var p=n.parentElement;
          if(!p||p.closest('script,style,#mobile-menu,#clawd-pet,#clawd-speech,#chat-app,noscript,svg,.lang-switch,.wm-drawer summary .cnt'))continue;
          if(n.textContent.trim())nodes.push(n);
        }
        return nodes;
      }
      function _punct(t){var kk=_kao[Math.floor(Math.random()*_kao.length)];return t.replace(/([。！？；…\.\!\?\;])/g,'$1 '+kk+' ')}
      function _paintUI(on){
        document.querySelectorAll('.lang-switch').forEach(function(box){
          var zh=box.querySelector('[data-seg="zh"]'),
              en=box.querySelector('[data-seg="en"]'),
              k=box.querySelector('[data-seg="kaomoji"]'),
              cur=box.getAttribute('data-lang');
          if(k)k.classList.toggle('is-active',on);
          if(zh)zh.classList.toggle('is-active',!on&&cur==='zh');
          if(en)en.classList.toggle('is-active',!on&&cur==='en');
        });
      }
      function _applyKao(on){
        _kaoOn=on;
        var nodes=_walkNodes();
        nodes.forEach(function(n){
          if(n._orig===undefined)n._orig=n.textContent;
          n.textContent=on?_punct(n._orig):n._orig;
        });
        _paintUI(on);
      }
      window._toggleKaomoji=function(){
        var on=!_kaoOn;
        localStorage.setItem('kaomoji',on?'1':'0');
        _applyKao(on);
      };
      document.addEventListener('DOMContentLoaded',function(){
        if(localStorage.getItem('kaomoji')==='1')_applyKao(true);else _paintUI(false);
      });
    </script>

    <header class="wm-header">
      <div class="w-full px-6 2xl:px-12 flex items-center h-16 relative">
        <a href={L("/")} class="flex items-center">
          <img src="/pacman.svg" alt="bt" width="28" height="28" class="inline-block" />
        </a>

        <!-- Desktop nav (centered) -->
        <nav class="hidden lg:flex gap-7 items-center absolute left-1/2 -translate-x-1/2">
          <a href={L("/chat/")} class="nav-link">{t("navChat")}</a>
          <a href="/games/" class="nav-link">Games</a>
          <a href={L("/archives/")} class="nav-link">{t("navArchives")}</a>
          <a href="/radio/" class="nav-link">{t("navGadgets")}</a>
          <a href={L("/about/")} class="nav-link">{t("navAbout")}</a>
        </nav>

        <!-- Desktop only: language switch + upcoming -->
        <div class="hidden md:flex items-center gap-5 ml-auto">
          <LangSwitch lang={lang} pathname={pathname} />
          <div class="upcoming-dropdown">
            <span class="text-[10px] uppercase tracking-[0.2em] cursor-default select-none font-mono font-bold" style="color: var(--wm-muted)">{t("upcoming")}</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-1 inline" style="color: var(--wm-muted)"><polyline points="6 9 12 15 18 9"/></svg>
            <div class="upcoming-menu glass-card !p-4 absolute top-full right-0 pt-0 min-w-[230px] space-y-3 z-[110]">
              <div class="upcoming-bridge"></div>
              <a href="https://github.com/jingyaogong/minimind" target="_blank" class="block hover:bg-[var(--wm-panel)] -mx-1 px-1 py-1 transition-colors">
                <p class="wm-kicker mb-1">AI</p>
                <p class="text-sm" style="color: var(--wm-ink-soft)">🤖 MiniMind</p>
                <p class="text-[10px] mt-0.5" style="color: var(--wm-muted)">{t("upcomingItems")}</p>
              </a>
            </div>
          </div>
        </div>

        <!-- Theme toggle (always visible, outside desktop-only group) -->
        <button id="theme-toggle" class="ml-auto md:ml-2 transition-colors" style="color: var(--wm-muted)" aria-label="Toggle theme" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-muted)'">
          <img id="theme-icon" src="/off.svg" alt="theme" width="20" height="20" style="filter:none" />
        </button>
        <script is:inline>
          (function(){
            var btn=document.getElementById('theme-toggle');
            var icon=document.getElementById('theme-icon');
            function setTheme(dark){
              document.documentElement.classList.toggle('dark',dark);
              localStorage.setItem('theme',dark?'dark':'light');
              icon.src=dark?'/on.svg':'/off.svg';
              icon.style.filter=dark?'invert(1)':'none';
            }
            setTheme(document.documentElement.classList.contains('dark'));
            btn.onclick=function(){setTheme(!document.documentElement.classList.contains('dark'))};
          })();
        </script>

        <!-- Mobile hamburger (only < 640px) -->
        <label for="menu-toggle" class="spacex-hamburger hidden max-sm:flex flex-col items-center justify-center">
          <span></span><span></span><span></span>
        </label>
      </div>
    </header>

    <!-- Mobile menu overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-[90] flex-col items-center justify-center gap-6" style="display:none; background: var(--wm-paper); border-bottom: 1px dotted var(--wm-dotted)">
      <a href={L("/chat/")} class="text-2xl transition-colors font-semibold tracking-wide" style="color: var(--wm-ink-soft)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-ink-soft)'" onclick="document.getElementById('mobile-menu').style.display='none';document.getElementById('menu-toggle').checked=false">{t("navChat")}</a>
      <a href="/games/" class="text-2xl transition-colors font-semibold tracking-wide" style="color: var(--wm-ink-soft)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-ink-soft)'" onclick="document.getElementById('mobile-menu').style.display='none';document.getElementById('menu-toggle').checked=false">Games</a>
      <a href={L("/archives/")} class="text-2xl transition-colors font-semibold tracking-wide" style="color: var(--wm-ink-soft)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-ink-soft)'" onclick="document.getElementById('mobile-menu').style.display='none';document.getElementById('menu-toggle').checked=false">{t("navArchives")}</a>
      <a href="/radio/" class="text-2xl transition-colors font-semibold tracking-wide" style="color: var(--wm-ink-soft)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-ink-soft)'" onclick="document.getElementById('mobile-menu').style.display='none';document.getElementById('menu-toggle').checked=false">{t("navGadgets")}</a>
      <a href={L("/about/")} class="text-2xl transition-colors font-semibold tracking-wide" style="color: var(--wm-ink-soft)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-ink-soft)'" onclick="document.getElementById('mobile-menu').style.display='none';document.getElementById('menu-toggle').checked=false">{t("navAbout")}</a>

      <!-- Language -->
      <div class="mt-4" onclick="document.getElementById('mobile-menu').style.display='none';document.getElementById('menu-toggle').checked=false">
        <LangSwitch lang={lang} pathname={pathname} size="md" />
      </div>

      <!-- Upcoming -->
      <div class="mt-6 pt-6 border-t border-dotted text-center" style="border-color: var(--wm-dotted)">
        <p class="text-[10px] uppercase tracking-[0.2em] mb-2 font-mono font-bold" style="color: var(--wm-muted)">{t("upcoming")}</p>
        <p class="text-xs" style="color: var(--wm-muted)">{t("upcomingItems")}</p>
      </div>
    </div>

    <div class="relative z-10 w-full px-4 md:px-8 xl:px-16 2xl:px-24 pt-24 pb-16">
      <div class="flex gap-8">
        {!hideSidebar && (
        <!-- Desktop sidebar (always visible md+) -->
        <aside id="sidebar" class="w-64 shrink-0 hidden md:block">
          <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto space-y-6">
            <SidebarContent lang={lang} />
          </div>
        </aside>
        )}

        <!-- Main area -->
        <main id="main" class="flex-1 min-w-0 pb-16">
          <slot />
        </main>
      </div>
    </div>

    <footer class="relative z-10 flex justify-center items-center gap-3 text-xs py-8 font-mono" style="color: var(--wm-muted)">
      <a href="mailto:bingtao2077@gmail.com" class="transition-colors" style="color: var(--wm-muted)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-muted)'" title="Email">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 4-10 8L2 4"/></svg>
      </a>
      <span>|</span>
      <a href="https://www.zhihu.com/people/liu-run-run-28" target="_blank" class="transition-colors" style="color: var(--wm-muted)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-muted)'">知乎</a>
      <span>|</span>
      <a href="https://github.com/yahoofunny/blog" target="_blank" class="transition-colors" style="color: var(--wm-muted)" onmouseover="this.style.color='var(--wm-primary)'" onmouseout="this.style.color='var(--wm-muted)'" title="GitHub">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.604-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <span>&mdash; {siteConfig.title} &copy; {new Date().getFullYear()}</span>
    </footer>

    {/* 写全 index.html：`/bg-particle/` 这种目录地址 Astro 开发服务器不解析索引，
        会 404（生产环境 Cloudflare Pages 会兜住，所以只在本地看着像坏了）。 */}
    <iframe id="wm-particle" src="/bg-particle/index.html" title="" aria-hidden="true" tabindex="-1"></iframe>
    {!hidePet && (
      <>
    <div id="clawd-pet" class="clawd-pet" title={t("clawdHint")} data-chat={L("/chat/")} role="button" tabindex="0" aria-label={t("clawdHint")}><img id="clawd-img" src="/clawd/clawd-idle.gif" style="width:100px;height:100px" draggable="false" alt=""/></div>
    <div id="clawd-speech" class="clawd-speech" aria-hidden="true"></div>
    <script is:inline>
(function(){
var p=document.getElementById("clawd-pet"),b=document.getElementById("clawd-speech"),i=document.getElementById("clawd-img");
if(!p||!b||!i)return;
var gifs=["idle","idle","idle-reading","idle-reading","thinking","idle","conducting","idle-reading","typing","thinking","sweeping","idle","headphones-groove","juggling","sleeping","happy","error","building","carrying","notification","bubble"];
function rnd(){i.src="/clawd/clawd-"+gifs[Math.floor(Math.random()*gifs.length)]+".gif"}
setInterval(rnd,10000);rnd();
var qs=["Hello!","今天过得咋样","写代码了吗","早点睡别熬夜","bt最棒","🦞","金鳞岂是池中物","你是bt的朋友吗","欢迎来到bt的网站","你是bt要等的人吗","一起加油呀","有什么需要帮忙的吗","这个博客真不错","我喜欢这里的音乐","好久不见呀","bt今天又更新博客了吗","bt是个有趣的灵魂","跟着bt学数据结构","bt写代码的样子很帅","这里永远是bt的精神自留地","bt等你很久了","bt的朋友就是我的朋友","有问题尽管问bt","bt的电路笔记超详细","bt说早点睡别熬夜"];
function spk(){var t=qs[Math.floor(Math.random()*qs.length)];b.textContent=t;b.style.opacity="1";var r=p.getBoundingClientRect();b.style.left=Math.max(10,r.left-50)+"px";b.style.top=Math.max(10,r.top-40)+"px";clearTimeout(b._t);b._t=setTimeout(function(){b.style.opacity="0"},3000)}
setInterval(function(){if(!document.hidden&&Math.random()<0.3)rnd();spk()},120000);
// 单击 = 去聊天页。鼠标端要留 220ms 给双击（双击是说俏皮话，不跳转）；
// 触摸端没有 dblclick，直接跳。
var navT=null;
function openChat(){var u=p.getAttribute("data-chat");if(u)location.href=u}
function clickPet(){if(navT)clearTimeout(navT);navT=setTimeout(openChat,220)}
var dr=false,cx=0,cy=0,sx=0,sy=0,moved=false;
function dragStart(x,y,t){
  dr=true;moved=false;var r=p.getBoundingClientRect();
  cx=r.left;cy=r.top;sx=x;sy=y;
  p.style.animation="none";p.style.transition="none";
  p.style.bottom="auto";p.style.right="auto";
  p.style.left=cx+"px";p.style.top=cy+"px";
  p.style.transform="translate(0,0)";
}
function dragMove(x,y){
  if(!dr)return;
  // 阈值不能省。真人点一下鼠标，指尖总有 1~2px 位移，浏览器就会发 mousemove ——
  // 之前这里无条件 moved=true，等于"点一下就变成拖拽"，于是永远进不了 clickPet()。
  // 桌宠点了没反应就是这个。
  if(!moved&&Math.abs(x-sx)<5&&Math.abs(y-sy)<5)return;
  moved=true;
  p.style.transform="translate("+(x-sx)+"px,"+(y-sy)+"px)";
}
function dragEnd(x,y){
  if(!dr)return;dr=false;
  var dx=x-sx,dy=y-sy;
  p.style.transform="";
  p.style.transition="";
  if(moved){
    // Commit position
    p.style.left=(cx+dx)+"px";p.style.top=(cy+dy)+"px";
  }else{
    // 只是点了一下：还原成右下角贴边，别把它钉成绝对坐标（否则窗口缩放时它不跟着走）
    p.style.left="";p.style.top="";p.style.bottom="20px";p.style.right="20px";
    clickPet();
  }
  p.style.animation="clawd-float 3s ease-in-out infinite";
}
p.onmousedown=function(e){dragStart(e.clientX,e.clientY,e)};
p.ontouchstart=function(e){var t=e.touches[0];dragStart(t.clientX,t.clientY,e)};
window.onmousemove=function(e){dragMove(e.clientX,e.clientY)};
window.ontouchmove=function(e){var t=e.touches[0];dragMove(t.clientX,t.clientY);if(dr)t.preventDefault()};
window.onmouseup=function(e){dragEnd(e.clientX,e.clientY)};
window.ontouchend=function(e){if(!dr)return;dr=false;
  // 触摸端没有 dblclick，所以轻点直接跳，不用等 220ms
  if(!moved){p.style.left="";p.style.top="";p.style.bottom="20px";p.style.right="20px";openChat()}
  p.style.transform="";
  p.style.transition="";
  p.style.animation="clawd-float 3s ease-in-out infinite";};
p.ondblclick=function(){if(navT)clearTimeout(navT);spk()};
p.onkeydown=function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();openChat()}};
var lt=0;
var pv=parseInt(localStorage.getItem("cv")||0)+1;localStorage.setItem("cv",pv);
if(pv===1)setTimeout(spk,4000);
})();
    </script>
      </>
    )}
</body>

</html>
