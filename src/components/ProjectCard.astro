---
import { Image } from "astro:assets";
import type { ProjectEntry } from "@/data/project";
import { projectStatus } from "@/data/project";
import type { Locale } from "@/i18n/ui";

interface Props {
	project: ProjectEntry;
	variant?: "grid" | "row";
	lang?: Locale;
}

const { project, variant = "grid", lang = "zh" } = Astro.props;
const { title, tagline, cover, stack, status, publishDate } = project.data;
const state = projectStatus[status];
const href = lang === "en" ? `/en/projects/${project.id}/` : `/projects/${project.id}/`;
const year = publishDate.getFullYear();
const stateLabel = lang === "en" ? state.labelEn : state.label;
const moreLabel = lang === "en" ? "View project →" : "进入项目 →";
---

<a
	href={href}
	class:list={["project-card glass-card", variant === "row" && "project-card--row"]}
	aria-label={`查看项目：${title}`}
>
	<div class="project-card__cover">
		<Image src={cover.src} alt={cover.alt} width={360} height={360} />
		<span class="project-card__status" style={`color:${state.color};border-color:${state.color}`}>
			<span class="project-card__dot" style={`background:${state.color}`}></span>
			{stateLabel}
		</span>
	</div>

	<div class="project-card__body">
		<p class="project-card__kicker">PROJECT · {year}</p>
		<h3 class="project-card__title">{title}</h3>
		<p class="project-card__tagline">{tagline}</p>

		{stack.length > 0 && (
			<ul class="project-card__stack" aria-label="技术栈">
				{stack.slice(0, 5).map((item) => <li>{item}</li>)}
			</ul>
		)}

		<span class="project-card__more">{moreLabel}</span>
	</div>
</a>

<style>
	.project-card {
		display: grid;
		grid-template-rows: auto 1fr;
		padding: 0 !important;
		overflow: hidden;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.project-card:hover {
		transform: translateY(-2px);
	}

	.project-card__cover {
		position: relative;
		display: flex;
		justify-content: center;
		padding: 1.4rem 1.4rem 1.1rem;
		background:
			radial-gradient(circle at 50% 35%, rgba(84, 97, 255, 0.14), transparent 62%),
			#07070c;
		border-bottom: 1px dotted var(--wm-dotted);
		overflow: hidden;
	}

	.project-card__cover :global(img) {
		width: min(100%, 230px);
		height: auto;
		border-radius: 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
		transition: transform 0.35s ease;
	}

	.project-card:hover .project-card__cover :global(img) {
		transform: scale(1.035) rotate(-0.6deg);
	}

	.project-card__status {
		position: absolute;
		top: 0.8rem;
		left: 0.8rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.15rem 0.55rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		background: rgba(7, 7, 12, 0.72);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		backdrop-filter: blur(6px);
	}

	.project-card__dot {
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
	}

	.project-card__body {
		display: flex;
		flex-direction: column;
		padding: 1.15rem 1.25rem 1.25rem;
	}

	.project-card__kicker {
		margin: 0 0 0.35rem;
		color: var(--wm-muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.16em;
	}

	.project-card__title {
		margin: 0;
		color: var(--wm-ink);
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.project-card__tagline {
		margin: 0.45rem 0 0;
		color: var(--wm-ink-soft);
		font-size: 0.86rem;
		line-height: 1.7;
	}

	.project-card__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}

	.project-card__stack li {
		padding: 0.12rem 0.45rem;
		border: 1px solid var(--wm-dotted);
		border-radius: 0.25rem;
		color: var(--wm-muted);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
	}

	.project-card__more {
		margin-top: auto;
		padding-top: 0.9rem;
		color: var(--wm-primary);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
	}

	.project-card--row {
		grid-template-columns: 168px 1fr;
		grid-template-rows: 1fr;
	}

	.project-card--row .project-card__cover {
		border-bottom: 0;
		border-right: 1px dotted var(--wm-dotted);
		padding: 0.9rem;
		align-items: center;
	}

	.project-card--row .project-card__cover :global(img) {
		width: min(100%, 132px);
	}

	.project-card--row .project-card__status {
		top: 0.5rem;
		left: 0.5rem;
		font-size: 0.55rem;
	}

	.project-card--row .project-card__body {
		padding: 1rem 1.1rem 1rem;
	}

	.project-card--row .project-card__title {
		font-size: 1.02rem;
	}

	.project-card--row .project-card__tagline {
		font-size: 0.8rem;
		line-height: 1.55;
	}

	@media (max-width: 480px) {
		.project-card--row {
			grid-template-columns: 120px 1fr;
		}

		.project-card--row .project-card__cover :global(img) {
			width: 96px;
		}

		.project-card--row .project-card__tagline {
			display: none;
		}

		.project-card--row .project-card__stack {
			display: none;
		}
	}
</style>
