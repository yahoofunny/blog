---
import { type CollectionEntry } from "astro:content";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { siteConfig } from "@/site.config";

const allPosts = await getAllPosts();
const allSortedPosts = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
---

<PageLayout meta={{ title: "Home" }}>
  <!-- Hero -->
  <section class="mb-10 border-b border-dotted pb-8" style="border-color: var(--wm-dotted)">
    <p class="wm-kicker mb-3">bt's blog &mdash; tech notes</p>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-3 uppercase" style="font-family: var(--font-display)">
      {siteConfig.title}
    </h1>
    <p class="font-mono text-sm mb-4" style="color: var(--wm-muted)">金鳞岂是池中物，一遇风云便化龙</p>
    <div class="flex flex-wrap gap-3 mt-5">
      <a href="/posts/" class="wm-btn wm-btn-primary">Posts &rarr;</a>
      <a href="/about/" class="wm-btn wm-btn-paper">About</a>
      <a href="/radio/" class="wm-btn wm-btn-paper">Gadgets</a>
      <a href="https://github.com/yahoofunny/blog" target="_blank" class="wm-btn wm-btn-paper">GitHub</a>
    </div>
  </section>

  <!-- Command strip -->
  <section class="mb-10 font-mono text-xs flex items-center gap-3 px-4 py-3 border border-dotted" style="background: var(--wm-panel); border-color: var(--wm-dotted); color: var(--wm-ink-soft)">
    <span style="color: var(--wm-primary)">$</span>
    <span>curl -sL blog-6rb.pages.dev</span>
    <span class="ml-auto" style="color: var(--wm-muted)">// 文章全部免费开放</span>
  </section>

  <!-- Sort buttons -->
  <div id="sort-bar" class="flex flex-wrap gap-2 mb-6">
    <button class="sort-btn active" data-sort="newest">最新</button>
    <button class="sort-btn" data-sort="oldest">最早</button>
    <button class="sort-btn" data-sort="az">A &rarr; Z</button>
    <button class="sort-btn" data-sort="za">Z &rarr; A</button>
  </div>

  <div class="flex flex-col gap-4" id="post-list">
    {allSortedPosts.map((p) => (
      <a href={`/posts/${p.id}/`} class="glass-card block post-item" data-date={p.data.publishDate.toISOString()} data-title={p.data.title}>
        <p class="post-meta">
          {p.data.publishDate.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
        </p>
        <h2 class="text-xl font-semibold">{p.data.title}</h2>
        {p.data.description && (
          <p class="post-desc mt-2">{p.data.description}</p>
        )}
      </a>
    ))}
  </div>
</PageLayout>

<script is:inline>
  (function(){
    var btns = document.querySelectorAll('.sort-btn');
    var list = document.getElementById('post-list');
    var items = Array.from(list.querySelectorAll('.post-item'));

    btns.forEach(function(btn){
      btn.addEventListener('click', function(){
        btns.forEach(function(b){ b.classList.remove('active') });
        btn.classList.add('active');

        var sort = btn.dataset.sort;
        var sorted = items.slice().sort(function(a, b){
          if (sort === 'newest') return new Date(b.dataset.date) - new Date(a.dataset.date);
          if (sort === 'oldest') return new Date(a.dataset.date) - new Date(b.dataset.date);
          if (sort === 'az') return a.dataset.title.localeCompare(b.dataset.title, 'zh-CN');
          if (sort === 'za') return b.dataset.title.localeCompare(a.dataset.title, 'zh-CN');
          return 0;
        });
        sorted.forEach(function(item){ list.appendChild(item); });
      });
    });
  })();
</script>
