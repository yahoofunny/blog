---
import { type CollectionEntry } from "astro:content";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { siteConfig } from "@/site.config";

const allPosts = await getAllPosts();
const allSortedPosts = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];

const CS_TAGS = ["数据结构", "算法", "排序", "查找", "汇编语言", "8086", "电路", "模电", "期末复习", "考试"];
const isIelts = (p: CollectionEntry<"post">) => p.data.tags.includes("雅思");
const isCS = (p: CollectionEntry<"post">) => p.data.tags.some((t) => CS_TAGS.includes(t));
const isTest = (p: CollectionEntry<"post">) => p.data.tags.includes("壁纸") || p.data.title.includes("壁纸测试");

const ielts = allSortedPosts.filter(isIelts);
const cs = allSortedPosts.filter((p) => !isIelts(p) && isCS(p));
const essay = allSortedPosts.filter((p) => !isIelts(p) && !isCS(p) && !isTest(p));
const test = allSortedPosts.filter((p) => !isIelts(p) && !isCS(p) && isTest(p));

const groups = [
  { key: "ielts", label: "IELTS · 雅思", items: ielts },
  { key: "cs", label: "CS · 计算机专业", items: cs },
  { key: "essay", label: "随笔", items: essay },
  { key: "test", label: "测试", items: test },
];
---

<PageLayout meta={{ title: "Home" }}>
  <!-- Hero -->
  <section class="mb-10 border-b border-dotted pb-8" style="border-color: var(--wm-dotted)">
    <p class="wm-kicker mb-3">bt's blog &mdash; tech notes</p>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-3 uppercase" style="font-family: var(--font-display)">
      {siteConfig.title}
    </h1>
    <p class="font-mono text-sm mb-4" style="color: var(--wm-muted)">金鳞岂是池中物，一遇风云便化龙</p>
  </section>

  <!-- Sort buttons -->
  <div id="sort-bar" class="flex flex-wrap gap-2 mb-6">
    <button class="sort-btn active" data-sort="newest">最新</button>
    <button class="sort-btn" data-sort="oldest">最早</button>
    <button class="sort-btn" data-sort="az">A &rarr; Z</button>
    <button class="sort-btn" data-sort="za">Z &rarr; A</button>
  </div>

  <!-- Drawers -->
  <div class="flex flex-col">
    {groups.map((g) => (
      <details class="wm-drawer" open>
        <summary>
          <span>{g.label}</span>
          <span class="cnt">{g.items.length} 篇</span>
        </summary>
        <div class="flex flex-col gap-3 pb-6 pt-3" data-group={g.key}>
          {g.items.map((p) => (
            <a href={`/posts/${p.id}/`} class="glass-card block post-item !p-4" data-date={p.data.publishDate.toISOString()} data-title={p.data.title} data-pinned={p.data.pinned ? "1" : "0"}>
              <p class="post-meta">
                {p.data.pinned && (
                  <span class="mr-2 inline-flex items-center gap-1" style="color: var(--wm-primary); font-weight: 700">
                    <svg width="12" height="12" viewBox="0 0 640 640" aria-hidden="true"><path fill="currentColor" d="M160 96c0-17.7 14.3-32 32-32h256c17.7 0 32 14.3 32 32s-14.3 32-32 32h-29.5l10.3 134.1c37.1 21.2 65.8 56.4 78.2 99.7l3.8 13.4c2.8 9.7.8 20-5.2 28.1S490 416 480 416H160c-10 0-19.5-4.7-25.5-12.7s-8-18.4-5.2-28.1l3.7-13.4c12.4-43.3 41-78.5 78.2-99.7L221.5 128H192c-17.7 0-32-14.3-32-32m128 368h64v112c0 17.7-14.3 32-32 32s-32-14.3-32-32z"/></svg>
                    PINNED
                  </span>
                )}
                {p.data.publishDate.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
              </p>
              <h2 class="text-lg font-semibold">{p.data.title}</h2>
              {p.data.description && (
                <p class="post-desc mt-2">{p.data.description}</p>
              )}
            </a>
          ))}
        </div>
      </details>
    ))}
  </div>
</PageLayout>

<script is:inline>
  (function(){
    var btns = document.querySelectorAll('.sort-btn');

    function sortBox(box, sort) {
      var items = Array.from(box.querySelectorAll('.post-item'));
      var sorted = items.slice().sort(function(a, b){
        var pa = a.dataset.pinned === '1', pb = b.dataset.pinned === '1';
        if (pa !== pb) return pa ? -1 : 1;   // 置顶文章永远排最前
        if (sort === 'newest') return new Date(b.dataset.date) - new Date(a.dataset.date);
        if (sort === 'oldest') return new Date(a.dataset.date) - new Date(b.dataset.date);
        if (sort === 'az') return a.dataset.title.localeCompare(b.dataset.title, 'zh-CN');
        if (sort === 'za') return b.dataset.title.localeCompare(a.dataset.title, 'zh-CN');
        return 0;
      });
      sorted.forEach(function(item){ box.appendChild(item); });
    }

    btns.forEach(function(btn){
      btn.addEventListener('click', function(){
        btns.forEach(function(b){ b.classList.remove('active') });
        btn.classList.add('active');
        var sort = btn.dataset.sort;
        document.querySelectorAll('[data-group]').forEach(function(box){
          sortBox(box, sort);
        });
      });
    });
  })();
</script>
