---
import PageLayout from "@/layouts/Base.astro";
const meta = { description: "Claude FM - Lo-fi 24/7 Radio", title: "Claude FM" };
---

<PageLayout meta={meta}>
  <div class="glass-card !p-8 text-center">
    <p class="wm-kicker mb-2">Gadgets — Radio</p>
    <h1 class="text-2xl font-bold mb-2">Claude FM</h1>
    <p class="text-sm mb-6" style="color: var(--wm-muted)">24/7 Lo-fi &amp; Ambient</p>
    <audio controls autoplay class="w-full max-w-md mx-auto">
      <source src="https://lofi.stream.laut.fm/lofi" type="audio/mpeg" />
    </audio>
    <p class="font-mono text-xs mt-4" style="color: var(--wm-muted)">Powered by laut.fm</p>

	  <div class="glass-card !p-8 text-center mt-4">
	    <h2 class="text-xl font-bold mb-4">click it</h2>
	    <p class="text-sm mb-4" style="color: var(--wm-ink-soft)">给我发图片，点击下方按钮上传</p>
	    <a href="https://telegraph-image-download.pages.dev" target="_blank" class="wm-btn wm-btn-primary">
	      打开图床 →
	    </a>
	  </div>

	  <div class="glass-card !p-8 text-center mt-4">
	    <h2 class="text-xl font-bold mb-2">🌑 Drone Zone</h2>
	    <p class="text-sm mb-6" style="color: var(--wm-muted)">Dark Ambient — 伤感空间音乐</p>
	    <audio controls class="w-full max-w-md mx-auto">
	      <source src="https://ice4.somafm.com/dronezone-128-mp3" type="audio/mpeg" />
	    </audio>
	    <p class="font-mono text-xs mt-4" style="color: var(--wm-muted)">SomaFM Drone Zone</p>
	  </div>
  </div>
</PageLayout>
