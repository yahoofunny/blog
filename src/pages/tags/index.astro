---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const tagsWithCount = getUniqueTagsWithCount(allPosts);

const meta = {
  description: "Browse all tags",
  title: "Tags",
};
---

<PageLayout meta={meta}>
  <div class="glass-card !p-8 md:!p-12">
    <h1 class="text-2xl md:text-3xl font-bold mb-2">Tags</h1>
    <p class="font-mono text-xs mb-8" style="color: var(--wm-muted)">{tagsWithCount.length} tags in total</p>
    <div class="flex flex-wrap gap-3">
      {tagsWithCount.map(([tag, count]) => (
        <a href={`/tags/${tag}/`} class="glass-card !px-4 !py-3 inline-flex items-center gap-2 transition-colors">
          <span class="font-medium" style="color: var(--wm-ink)">{tag}</span>
          <span class="font-mono text-xs px-2 py-0.5 border" style="border-color: var(--wm-line); color: var(--wm-muted)">{count}</span>
        </a>
      ))}
    </div>
  </div>
</PageLayout>
